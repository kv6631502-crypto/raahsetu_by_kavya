# Copy to .env at the repository root. Never commit credentials.
DATASET_PATH=backend/data/demo-network.json
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GRAPH_CACHE_SIZE=1
# Optional: required only for the Supabase import/export commands.
# Use a Supabase direct or session-pooler Postgres connection with SSL.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
# Development-only: explicitly opt in to demo/test bearer tokens.
ALLOW_DEMO_AUTH=false
# Optional production notification adapter settings (keep server-side only).
SMS_PROVIDER=cdac
SMS_PROVIDER_BASE_URL=
SMS_PROVIDER_API_KEY=
WHATSAPP_PROVIDER=meta_cloud
WHATSAPP_GRAPH_URL=https://graph.facebook.com
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional vehicle/GPS ingestion gateway. Browser GPS remains available for demos.
GPS_INGESTION_BASE_URL=
GPS_INGESTION_API_KEY=
